-- =============================================================================
-- VIEW: anaplan_dev.td_gl_sum_backup_20220616_v
-- Source: Oracle ANAPLAN.TD_GL_SUM_BACKUP_20220616
-- CTE needed: NO extra flattening required — Oracle original already read
--   bousr.fpm_gl2_hst and mvxjdta.csycal directly, no ANAPLAN-view nesting.
--   fpm_gl2_hst confirmed a physical TABLE (not a view) via pgAdmin screenshot
--   earlier in this project, so this is already fully flat.
-- Rewritten as named CTEs instead of Oracle's inline nested subqueries, for
--   readability — no behaviour change.
-- Changes:
--   • DECODE(x, NULL, 0, x) -> COALESCE(x, 0)
--   • SubStr(cdymd8,0,6) -> SUBSTRING(cdymd8::TEXT,1,6)  (Oracle 0-based ->
--     PG 1-based, AND cdymd8 needs an explicit text cast — PG's SUBSTRING
--     rejects integer input. The ::TEXT cast was missing in the first
--     version of this file and failed during actual deployment; fixed live,
--     back-ported here so the source file matches what was validated)
--   • To_Char(SYSDATE,'YYYYMM') -> TO_CHAR(CURRENT_DATE,'YYYYMM')
--   • Analytic SUM() OVER (... RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
--     -> unchanged (ANSI, identical in PG)
--   • Double-quoted mixed-case Oracle column list -> plain lower-case
-- =============================================================================
CREATE OR REPLACE VIEW anaplan_dev.td_gl_sum_backup_20220616_v AS

-- P&L accounts (period actuals, no cumulation)
WITH pl_accounts AS (
    SELECT
        CAST(divi   AS VARCHAR(10)) AS division,
        CAST(acperi AS VARCHAR(10)) AS period,
        CAST(ait1   AS VARCHAR(30)) AS account_code,
        CAST(ait2   AS VARCHAR(30)) AS costcenter_code,
        acam                        AS amount_loc,
        CAST(ait3   AS VARCHAR(30)) AS dim3_code,
        CAST(ait4   AS VARCHAR(30)) AS counterpart_code,
        CAST(' '    AS VARCHAR(30)) AS ad_dim1,
        CAST(' '    AS VARCHAR(30)) AS ad_dim2,
        CAST(' '    AS VARCHAR(30)) AS ad_dim3
    FROM bousr.fpm_gl2_hst
    WHERE datatype = 'ACT'
      AND acperi >= '202001'
      AND ait1 BETWEEN '8000000' AND '9999998'
),
pl_accounts_summed AS (
    SELECT
        division, period, account_code, costcenter_code,
        SUM(amount_loc) AS amount_loc,
        dim3_code, counterpart_code, ad_dim1, ad_dim2, ad_dim3
    FROM pl_accounts
    GROUP BY division, period, account_code, costcenter_code,
             dim3_code, counterpart_code, ad_dim1, ad_dim2, ad_dim3
),

-- BS accounts (cumulative running total per division/account/dim3/counterpart)
bs_grouping_keys AS (
    SELECT divi, ait1, ait3,
           CASE WHEN ait1 LIKE '%9' THEN ait4 ELSE ' ' END AS ait4
    FROM bousr.fpm_gl2_hst
    WHERE datatype = 'ACT'
      AND ait1 BETWEEN '1000000' AND '7999999'
    GROUP BY divi, ait1, ait3, CASE WHEN ait1 LIKE '%9' THEN ait4 ELSE ' ' END
    HAVING COUNT(1) > 0
),
bs_periods AS (
    SELECT DISTINCT SUBSTRING(cdymd8::TEXT,1,6) AS period
    FROM mvxjdta.csycal
    WHERE SUBSTRING(cdymd8::TEXT,1,6) BETWEEN '201712' AND TO_CHAR(CURRENT_DATE,'YYYYMM')
),
bs_grid AS (
    -- every division/account/period combination, even where no activity occurred
    SELECT ac.divi, per.period, ac.ait1, ac.ait3, ac.ait4
    FROM bs_grouping_keys ac
    RIGHT JOIN bs_periods per ON 1=1
),
bs_actuals AS (
    SELECT
        divi, ait1, ait3, acperi,
        CASE WHEN ait1 LIKE '%9' THEN ait4 ELSE ' ' END AS ait4,
        SUM(acam) AS acam
    FROM bousr.fpm_gl2_hst
    WHERE datatype = 'ACT'
    GROUP BY divi, ait1, ait3, CASE WHEN ait1 LIKE '%9' THEN ait4 ELSE ' ' END, acperi
),
bs_cumulative AS (
    SELECT
        f.divi, f.period, f.ait1, f.ait3, f.ait4,
        COALESCE(dta.acam, 0) AS periodsum,
        SUM(COALESCE(dta.acam, 0)) OVER (
            PARTITION BY f.divi, f.ait1, f.ait3, f.ait4
            ORDER BY f.period
            RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ) AS cumul
    FROM bs_grid f
    LEFT JOIN bs_actuals dta
           ON f.divi = dta.divi AND f.ait1 = dta.ait1 AND f.ait3 = dta.ait3
          AND f.ait4 = dta.ait4 AND dta.acperi = f.period
),
bs_accounts AS (
    SELECT
        CAST(divi     AS VARCHAR(10)) AS division,
        CAST(period   AS VARCHAR(10)) AS period,
        CAST(ait1     AS VARCHAR(30)) AS account_code,
        CAST('BS999'  AS VARCHAR(30)) AS costcenter_code,
        cumul                          AS amount_loc,
        CAST(ait3     AS VARCHAR(30)) AS dim3_code,
        CAST(ait4     AS VARCHAR(30)) AS counterpart_code,
        CAST(' '      AS VARCHAR(30)) AS ad_dim1,
        CAST(' '      AS VARCHAR(30)) AS ad_dim2,
        CAST(' '      AS VARCHAR(30)) AS ad_dim3
    FROM bs_cumulative
    WHERE cumul <> 0 AND period >= '202001'
)

SELECT * FROM pl_accounts_summed
UNION ALL
SELECT * FROM bs_accounts;

COMMENT ON VIEW anaplan_dev.td_gl_sum_backup_20220616_v IS
    'P&L (period actuals) + BS (cumulative running total) GL amounts from bousr.fpm_gl2_hst. Historical backup view from 2022-06-16 — confirm with the business whether this snapshot is still needed before relying on it going forward.';
